{
  "manifest_version": 3,
  "name": "SpeedMaster for YouTube",
  "version": "1.0",
  "description": "YouTube playback speed controller with smart speed memory and ad acceleration.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "permissions": []
}